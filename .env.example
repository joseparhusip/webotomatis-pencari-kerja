# Konfigurasi lokal Webotomatis. Salin jadi .env lalu isi. JANGAN commit .env.

# --- Database & antrean (dipakai saat menjalankan tanpa Docker; di Docker di-override docker-compose) ---
DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5434/jobs
REDIS_URL=redis://localhost:6379

# --- AI penulis surat lamaran ---
# Gemini (Google AI Studio: https://aistudio.google.com/apikey). Dipakai bila terisi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Cadangan bila model utama sibuk/limit (JSON list)
GEMINI_FALLBACK_MODELS=["gemini-3.5-flash-lite"]
# minimal | low | medium | high — low: cepat & murah, cukup untuk surat lamaran
GEMINI_THINKING_LEVEL=low
# Claude (opsional, dipakai bila GEMINI_API_KEY kosong)
ANTHROPIC_API_KEY=

# --- Kirim lamaran via Gmail SMTP (App Password: https://myaccount.google.com/apppasswords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAX_EMAILS_PER_DAY=25

# --- Scraping ---
SCRAPE_INTERVAL_HOURS=3
# Halaman hasil per keyword per sumber (1 halaman = 30 lowongan)
SCRAPE_PAGES_PER_KEYWORD=2

# --- Instagram akun info loker (Meta Graph API, lihat README "Lowongan dari Instagram") ---
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
META_GRAPH_VERSION=v24.0
INSTAGRAM_MAX_AGE_DAYS=3

# --- Belum dipakai (fitur berikutnya) ---
# Google Jobs (https://serpapi.com — gratis ±100 pencarian/bulan). Dipakai 1x sehari.
SERPAPI_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SERPAPI_MAX_SEARCHES_PER_DAY=3
